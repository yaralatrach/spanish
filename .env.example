# Supabase -> Project Settings -> API.
# The service-role key is server-only and must never reach the browser.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Optional. Without it the app runs exactly as before: no journal correction,
# no reading passage. With it, both appear. Costs roughly $0.30/month at one
# entry a day. https://platform.claude.com/settings/keys
ANTHROPIC_API_KEY=

# Optional shared-password gate. Unset = no gate (local dev).
# Set this in Vercel before the app is publicly reachable.
APP_PASSWORD=
